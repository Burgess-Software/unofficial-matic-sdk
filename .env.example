# Network identity is device-specific. Do not put a BotToken in this file.
MATIC_HOST=robot-host-or-ip
MATIC_PORT=16320
MATIC_AUTHORITY=robot-hostname:16320
MATIC_SERVER_NAME=robot-certificate-name
MATIC_DEVICE_ALIAS=my-matic
MATIC_CERT_SHA256=verified-64-character-certificate-sha256
# Read this from the current_version collection before sending commands.
MATIC_PROTOCOL_VERSION=25
